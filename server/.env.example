# NODE_ENV — required. "production" enables Secure cookies and HSTS.
NODE_ENV=

# PORT — optional, default 3000. Listen port.
PORT=

# DATABASE_URL — required. Postgres connection string.
DATABASE_URL=

# DATABASE_POOL_SIZE — optional, default 10. Set so instances x pool_size
# stays under the managed database's connection limit (SRS §6.1).
DATABASE_POOL_SIZE=

# REDIS_URL — REQUIRED. Rate limits (FR-5.6), and quota and spend counters
# from steps 45-46. The API runs as two or more stateless instances, so a
# counter in process memory is not a limit at all. e.g. redis://localhost:6379
REDIS_URL=

# ANTHROPIC_API_KEY — required. Server-side only, never sent to the browser.
ANTHROPIC_API_KEY=

# ANTHROPIC_MODEL — required. Must match a known SRS §5.4 parameter profile
# (currently: claude-opus-5, claude-sonnet-5, claude-opus-4-8,
# claude-opus-4-7, claude-opus-4-6, claude-sonnet-4-6, claude-haiku-4-5).
# Changing this in production is gated by the accuracy benchmark (§10.4).
# Benchmarked default: claude-sonnet-5. It is the cheapest candidate measured
# to derive overall_risk correctly on all four fixtures with no run-to-run
# variation; claude-haiku-4-5 is ~40% cheaper per analysis but gets one
# document's risk wrong and flaps. See docs/phase-1-dod.md §8.
ANTHROPIC_MODEL=

# LLM_TIMEOUT_MS — optional, default 60000. FR-3.6.
LLM_TIMEOUT_MS=

# LLM_MAX_RETRIES — optional, default 2. FR-3.10.
LLM_MAX_RETRIES=

# LLM_PRICE_INPUT_PER_MTOK — REQUIRED. Spend estimation (FR-5.3). USD per
# million input tokens for the configured model. RE-SET THIS WHENEVER
# ANTHROPIC_MODEL CHANGES, or the estimate meters the new model at the old
# price; scripts/benchmark.js checks it, since it already gates model
# changes. claude-sonnet-5 list price: 2.00
LLM_PRICE_INPUT_PER_MTOK=

# LLM_PRICE_OUTPUT_PER_MTOK — REQUIRED. USD per million output tokens for
# the configured model. claude-sonnet-5 list price: 10.00
LLM_PRICE_OUTPUT_PER_MTOK=

# MONTHLY_SPEND_CEILING_USD — REQUIRED. FR-5.4: warn at 50% and 80%, and
# at 100% new analyses return 503 SPEND_LIMIT_REACHED while existing
# reports, history, login and deletion keep working (PRD D13).
MONTHLY_SPEND_CEILING_USD=

# MONTHLY_ANALYSIS_QUOTA — optional, default 50. FR-5.1.
MONTHLY_ANALYSIS_QUOTA=

# HOURLY_ANALYSIS_LIMIT — optional, default 10. FR-5.1.
HOURLY_ANALYSIS_LIMIT=

# MAX_CONCURRENT_UPLOADS — optional, default 10. FR-2.12.
MAX_CONCURRENT_UPLOADS=

# MAX_DOCUMENT_WORDS — optional, default 4000. FR-2.6.
MAX_DOCUMENT_WORDS=

# MIN_DOCUMENT_WORDS — optional, default 200. FR-2.5.
MIN_DOCUMENT_WORDS=

# MAX_PDF_PAGES — optional, default 100. FR-2.10.
MAX_PDF_PAGES=

# MAX_DOCS_PER_USER — optional, default 100. FR-2.13.
MAX_DOCS_PER_USER=

# MAX_BYTES_PER_USER — optional, default 52428800 (50 MB). FR-2.13.
MAX_BYTES_PER_USER=

# RETENTION_DAYS — optional, default 90. FR-4.4.
RETENTION_DAYS=

# BACKUP_DIR — optional. A directory holding the database backup files,
# read by the weekly backup-verify job (SRS §12.3). Unset in development
# means the job is simply not scheduled. Unset in PRODUCTION does not skip
# the check: the job runs and fails, and backup_verify_failed pages.
BACKUP_DIR=

# BACKUP_MIN_BYTES — optional, default 1048576 (1 MiB). A backup smaller
# than this is treated as truncated or empty.
BACKUP_MIN_BYTES=

# BACKUP_MAX_AGE_HOURS — optional, default 36. A newest backup older than
# this means backups have stopped.
BACKUP_MAX_AGE_HOURS=

# JWT_SECRET — required. At least 32 random bytes. Rotating this logs
# everyone out.
JWT_SECRET=

# AUDIT_SALT — REQUIRED. At least 32 random bytes. HMAC salt for audit
# subject/IP hashes (lib/audit.js). NEVER ROTATE CASUALLY: rotating it
# silently breaks correlation across every historical AuditEvent row —
# every subjectHash and ipHash ever written becomes unmatchable. Treat it
# differently from JWT_SECRET in the rotation runbook (step 74).
AUDIT_SALT=

# FRONTEND_ORIGIN — required. Exact origin for CORS, e.g.
# https://app.example.com. No wildcard, no path.
FRONTEND_ORIGIN=

# EMAIL_PROVIDER — optional, default "sink". Which transport sends
# transactional email. "sink" writes each message to disk instead of sending
# it, for development and the E2E tests, and config.js REFUSES to boot with
# it in production (it would silently swallow every verification email).
# A real provider is added by extending the enum; see src/lib/email/.
EMAIL_PROVIDER=

# EMAIL_SINK_DIR — optional. Where the sink writes messages, one JSON file
# each. Defaults to ./.mail-sink outside tests. An E2E run in another process
# reads the verification token from here.
EMAIL_SINK_DIR=

# EMAIL_PROVIDER_KEY — required once a real provider is configured; unused by
# "sink". The provider's API key. Server-side only.
EMAIL_PROVIDER_KEY=

# EMAIL_FROM — the sender address, on a domain verified with the provider
# (SPF, DKIM, DMARC). Unused by "sink", which sends from
# noreply@clausecheck.invalid.
EMAIL_FROM=

# SENTRY_DSN — optional. Error tracking; absent disables it cleanly.
SENTRY_DSN=

# LOG_LEVEL — optional, default "info". SRS §6.5.
LOG_LEVEL=

# ANALYSIS_ENABLED — optional, default true. Feature flag behind FR-5.4 and
# PRD §15 rollback. Literal "true" or "false" — anything else fails boot.
ANALYSIS_ENABLED=

# GIT_SHA — required from step 40 [P1.5]. Reported by /api/version, set by
# CI at build time.
GIT_SHA=

# BUILD_TIMESTAMP — required from step 40 [P1.5]. Reported by /api/version
# (FR-4.8), set by CI at build time. ISO 8601.
BUILD_TIMESTAMP=
