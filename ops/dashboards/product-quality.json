{
  "uid": "clausecheck-quality",
  "title": "ClauseCheck: product quality",
  "description": "SRS \u00a76.6's quality dashboard: the one that answers PRD \u00a711's questions. Thresholds on each panel are PRD \u00a711's own.",
  "tags": [
    "clausecheck"
  ],
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "utc",
  "editable": true,
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Analyses per day",
      "description": "Analyses reaching a terminal state, per day. Refusals before an analysis exists (quota, spend, verification) are not analyses.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(analysis_total[1d]))",
          "legendFormat": "analyses"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Outcome mix",
      "description": "Terminal outcomes per day, by outcome and error code.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (outcome, error_code) (increase(analysis_total[1d]))",
          "legendFormat": "{{outcome}} {{error_code}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Analyses ending in an error",
      "description": "Failed share over a day. PRD \u00a711.2 target: < 2% (the line).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.02
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(analysis_total{outcome=\"failed\"}[1d])) / sum(increase(analysis_total[1d]))",
          "legendFormat": "failed share"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Discard rate (7 days)",
      "description": "Findings discarded by excerpt verification over all findings the model reported (shown + discarded). PRD \u00a711.1: target < 5% (amber); > 10% over 7 days triggers a review of \u00a75.3's strictness (red).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(analysis_findings_discarded_total[7d])) / (sum(increase(analysis_findings_discarded_total[7d])) + sum(increase(analysis_findings_total[7d])))",
          "legendFormat": "discard rate"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Rule/model risk drift (7 days)",
      "description": "Completed analyses where the rule-derived risk (shown) differs from the model's claim. PRD \u00a711.1: tracked, no target; > 25% prompts a rule review (the line).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.25
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(analysis_risk_drift_total[7d])) / sum(increase(analysis_total{outcome=\"completed\"}[7d]))",
          "legendFormat": "drift"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Drift, by pair",
      "description": "Which way the rule and the model disagree, over 7 days.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (rule_risk, model_risk) (increase(analysis_risk_drift_total[7d]))",
          "legendFormat": "rule {{rule_risk}} / model {{model_risk}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Findings shown, by severity",
      "description": "Verified findings per day, by severity.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (severity) (increase(analysis_findings_total[1d]))",
          "legendFormat": "{{severity}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Spend against ceiling",
      "description": "Estimated provider spend this month over the configured ceiling (FR-5.4). The 50/80/100% alert thresholds are the colour steps. Both are shared state: max(), never sum().",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 1.0
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(llm_spend_usd_month) / max(llm_spend_ceiling_usd)",
          "legendFormat": "of ceiling"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Spend this month",
      "description": "Estimated USD.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(llm_spend_usd_month)",
          "legendFormat": "USD"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(llm_spend_ceiling_usd)",
          "legendFormat": "ceiling"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Tokens per analysis",
      "description": "Average input and output tokens per analysis, per day: the cost driver PRD \u00a710 models.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (direction) (increase(llm_tokens_total[1d])) / scalar(sum(increase(analysis_total[1d])))",
          "legendFormat": "{{direction}}"
        }
      ]
    }
  ]
}